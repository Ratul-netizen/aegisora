  "db_name": "PostgreSQL",
  "query": "\n            SELECT\n                id,\n                tenant_id      AS \"tenant_id: TenantId\",\n                job_id,\n                ranges::text[] AS \"ranges!: Vec<String>\",\n                trigger,\n                started_by     AS \"started_by: ActorId\",\n                started_at,\n                finished_at,\n                status,\n                error,\n                probed, answered, created, merged, for_review, candidates, edges\n              FROM discovery_run\n             WHERE tenant_id = $1\n             ORDER BY started_at DESC\n             LIMIT $2\n            ",
