{
  "db_name": "PostgreSQL",
  "query": "\n            SELECT\n                id,\n                tenant_id         AS \"tenant_id: TenantId\",\n                name,\n                description,\n                ranges::text[]    AS \"ranges!: Vec<String>\",\n                site_id           AS \"site_id: SiteId\",\n                credential_refs,\n                snmp_port,\n                skip_silent_hosts,\n                EXTRACT(EPOCH FROM schedule)::bigint AS \"schedule_seconds: i64\",\n                enabled,\n                last_run_at,\n                created_by        AS \"created_by: ActorId\",\n                created_at,\n                updated_at\n              FROM discovery_job\n             WHERE tenant_id = $1\n             ORDER BY name\n            ",
