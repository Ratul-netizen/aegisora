  "query": "\n            SELECT r.tenant_id AS \"tenant_id: TenantId\", r.role AS \"role: Role\"\n              FROM user_tenant_role r\n              JOIN app_user u ON u.id = r.user_id\n             WHERE r.user_id = $1 AND u.disabled_at IS NULL\n             ORDER BY r.tenant_id\n            ",
