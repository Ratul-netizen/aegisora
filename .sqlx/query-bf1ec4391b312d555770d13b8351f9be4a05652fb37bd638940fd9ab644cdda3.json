  "query": "\n            SELECT\n                id, rule_id,\n                resource_id AS \"resource_id: ResourceId\",\n                dedup_key, state, since, last_eval, last_value,\n                acked_by    AS \"acked_by: ActorId\",\n                acked_at\n              FROM alert_state\n             WHERE tenant_id = $1 AND state IN ('pending', 'firing')\n             ORDER BY since DESC\n            ",
