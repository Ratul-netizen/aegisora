# Normalize line endings in the repo to LF. Without this, a Windows checkout commits
# CRLF into files that Linux containers and CI will read, which breaks shell scripts
# and produces noisy diffs between contributors on different platforms.
* text=auto eol=lf

# Scripts that must keep platform-native endings
*.ps1 text eol=crlf
*.cmd text eol=crlf
*.bat text eol=crlf

# Never touch binaries
*.png binary
*.jpg binary
*.gz  binary
*.zip binary
